agents:
  general:
    enabled: true
    description: "Fallback agent for greetings, unclear requests, and unsupported tasks."

  knowledge:
    enabled: true
    description: "Answers questions about BioOps documentation, pipeline metadata, source code, inputs, outputs, and explanations."

  cluster_health:
    enabled: true
    description: "Checks Kubernetes cluster health, pods, logs, unhealthy containers, running steps, cost, and ETA."
    namespace: bioops
    request_timeout_seconds: 5
    log_tail_lines: 50
    cost:
      mode: local_free
      currency: rub
    step_eta_minutes:
      bam-to-gvcf: 120
      gvcf-to-vcf: 45
      transfer-bam: 10
      transfer-vcf: 10

  review:
    enabled: true
    description: "Reviews repositories, PRs/MRs, code changes, risks, style, logic issues, and missing tests."

  submit_master:
    enabled: true
    description: "Generates original-compatible submit-master configs, prepares safe launch plans, monitors submit-master runs, and reports failed pods."
    allow_launch: false
    allow_restart: false
    argo_command: "argo"
    argo_namespace: argo
    workflow_file: ""
    submit_master_entrypoint: ""
    generated_config_dir: "logs/submit_master_configs"
    contour: "prod"
    python_executable: "python3"
    launch_timeout_seconds: 900
