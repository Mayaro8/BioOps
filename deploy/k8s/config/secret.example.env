# Azure OpenAI — required for routing, Knowledge, and LLM Review
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_OPENAI_ENDPOINT=REPLACE_ME
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=REPLACE_ME
AZURE_OPENAI_DEPLOYMENT=REPLACE_ME
AZURE_OPENAI_MODEL=REPLACE_ME
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=REPLACE_ME

# GitHub Review Agent
GITHUB_TOKEN=REPLACE_ME

# Yandex Identity Hub corporate OIDC SSO
YANDEX_SSO_OPENID_CONFIGURATION_URL=REPLACE_WITH_IDENTITY_HUB_OPENID_CONFIGURATION_URL
YANDEX_SSO_CLIENT_ID=REPLACE_ME
YANDEX_SSO_CLIENT_SECRET=REPLACE_ME
BIOOPS_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
BIOOPS_LOCAL_ACCESS_CODE=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_VALUE

# Read-only Yandex Cloud integration for Infra & Cost Agent. Do not commit real values.
BIOOPS_INFRA_PROVIDER=yandex
YC_FOLDER_ID=REPLACE_WITH_YOUR_CLOUD_FOLDER_ID
YC_BILLING_ACCOUNT_ID=REPLACE_WITH_YOUR_BILLING_ACCOUNT_ID
# Prefer a mounted key file in production. This JSON alternative is supported for Kubernetes Secrets.
YC_SERVICE_ACCOUNT_KEY_JSON=REPLACE_WITH_SERVICE_ACCOUNT_KEY_JSON

# Bitrix chat integration
BITRIX_WEBHOOK_URL=REPLACE_ME
BITRIX_DIALOG_ID=REPLACE_ME

# Internal browser alerts
BIOOPS_INTERNAL_ALERT_TOKEN=REPLACE_ME
