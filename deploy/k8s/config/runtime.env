BIOOPS_ENV=kubernetes
BIOOPS_NAMESPACE=bioops-dev
PYTHONPATH=/app/src
PYTHONUNBUFFERED=1

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=bioops_knowledge
QDRANT_WIKI_COLLECTION=bioops_knowledge_wiki

YANDEX_WIKI_ENABLED=false
YANDEX_WIKI_API_URL=https://api.wiki.yandex.net/v1
YANDEX_WIKI_WEB_URL=https://wiki.yandex.com
YANDEX_WIKI_ROOT_SLUG=
YANDEX_WIKI_ORG_ID=
YANDEX_WIKI_ORG_HEADER=X-Org-Id
YANDEX_WIKI_AUTH_SCHEME=OAuth
YANDEX_WIKI_MIN_SCORE=0.35
YANDEX_WIKI_MAX_PAGES=1000
YANDEX_WIKI_TIMEOUT_SECONDS=15

BIOOPS_SSO_ENABLED=true
YANDEX_SSO_REDIRECT_URI=https://bioops.84-201-181-221.sslip.io/auth/sso/callback
YANDEX_SSO_TOKEN_AUTH_METHOD=client_secret_post
BIOOPS_AUTH_ALLOWED_DOMAIN=genotek.ru
BIOOPS_AUTH_BOOTSTRAP_EMAILS=
BIOOPS_SSO_TIMEOUT_SECONDS=10
BIOOPS_SESSION_TTL_HOURS=12
BIOOPS_SESSION_COOKIE=bioops_session
BIOOPS_COOKIE_SECURE=true
BIOOPS_AUTH_DB_PATH=/data/bioops_auth.sqlite3
BIOOPS_LOCAL_ACCESS_ENABLED=true

BATCH_STATUS_DB_PATH=/data/bioops_batch_status.sqlite3

ALERT_CHANNEL=console
TZ=Europe/Moscow
